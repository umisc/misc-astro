{
  "name": "misc-astro",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "CLOUDFLARE_ENV=preview astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "preview": "astro preview",
    "astro": "astro",
    "event:add": "node scripts/add-event.mjs",
    "fix": "prettier --write . && eslint --fix . && tailwind-lint --fix 'src/**/*.{astro,js,jsx,ts,tsx}'",
    "check": "astro check && eslint . --max-warnings 0 && prettier --check .",
    "ci": "pnpm check",
    "db:migrate:local": "wrangler d1 migrations apply misc-astro-dev --local",
    "db:execute:local": "wrangler d1 execute misc-astro-dev --local",
    "cf:types": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "astro-embed": "^0.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "motion": "^13.2.0",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-lint": "^0.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "4.129.1"
  }
}
