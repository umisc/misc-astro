{
  "name": "misc-astro",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm db:setup:local && astro dev",
    "build": "astro build",
    "build:deploy": "CLOUDFLARE_ENV=production astro build",
    "preview": "astro preview",
    "astro": "astro",
    "event:add": "node scripts/add-event.mjs",
    "fix": "prettier --write . && eslint --fix . && tailwind-lint --fix 'src/**/*.{astro,js,jsx,ts,tsx}'",
    "check": "astro check && eslint . --max-warnings 0 && prettier --check .",
    "ci": "pnpm check",
    "db:migrate:local": "wrangler d1 migrations apply misc-astro-dev --local",
    "db:seed:local": "wrangler d1 execute misc-astro-dev --local --yes --file=db/seed.preview.sql",
    "db:setup:local": "wrangler d1 migrations apply misc-astro-dev --local && wrangler d1 execute misc-astro-dev --local --yes --file=db/seed.preview.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:setup:local",
    "db:execute:local": "wrangler d1 execute misc-astro-dev --local",
    "cf:types": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "astro-embed": "^0.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "motion": "^14.8.0",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-lint": "^0.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "4.156.0"
  }
}
