{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misc-astro",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "misc-astro-dev",
      "database_id": "22f2a591-e0a1-41d3-a155-ef51d1079a8f",
      "preview_database_id": "22f2a591-e0a1-41d3-a155-ef51d1079a8f",
    },
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "prod",
          "database_id": "b25b8194-abe3-4282-9ef7-7b02d0bbdac4",
        },
      ],
    },
  },
}
