---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '@/components/site/SiteHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import AuroraBackground from '@/components/effects/aurora/AuroraBackground.astro';
import socialImage from '@/pages/_home/_assets/misc-head-fallback.webp';
import organisationLogo from '@/assets/brand/umisc-logo.png';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string | URL | false;
  includeOrganizationSchema?: boolean;
}

const {
  title = 'MISC — Melbourne Information Security Club',
  description = 'Join the Melbourne Information Security Club at the University of Melbourne for cybersecurity workshops, events, CTF competitions, and an inclusive student community.',
  noindex = false,
  canonical,
  includeOrganizationSchema = false,
} = Astro.props;

const canonicalURL =
  canonical === false
    ? undefined
    : new URL(canonical ?? Astro.url.pathname, Astro.site);
const socialImageURL = new URL(socialImage.src, Astro.site);
const organisationLogoURL = new URL(organisationLogo.src, Astro.site);
const organisationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${new URL('/', Astro.site).href}#organization`,
  name: 'Melbourne Information Security Club',
  alternateName: 'MISC',
  description:
    'The University of Melbourne Information Security Club (MISC) provides an inclusive community for students building practical cybersecurity skills.',
  url: new URL('/', Astro.site).href,
  logo: {
    '@type': 'ImageObject',
    url: organisationLogoURL.href,
    width: organisationLogo.width,
    height: organisationLogo.height,
  },
  foundingDate: '2017',
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'The University of Melbourne',
    url: 'https://www.unimelb.edu.au/',
  },
  sameAs: [
    'https://www.facebook.com/uomisc/',
    'https://instagram.com/unimelb_misc',
    'https://www.linkedin.com/company/melbourne-information-security-club/',
    'https://github.com/umisc',
  ],
};
---

<html lang="en" class="bg-canvas text-foreground">
  <head>
    <meta charset="utf-8" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow'}
    />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MISC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={socialImageURL} />
    <meta
      property="og:image:alt"
      content="Melbourne Information Security Club"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48"
    />
    <title>{title}</title>
    {
      includeOrganizationSchema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(organisationSchema)}
        />
      )
    }
    <ClientRouter />
  </head>
  <body
    class="isolate flex min-h-dvh flex-col overflow-x-clip bg-transparent font-sans antialiased"
  >
    <AuroraBackground />
    <SiteHeader />
    <main class="relative z-10 flex-1 pb-page-block">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
